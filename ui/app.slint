import {
    MaterialWindow,
    MaterialPalette,
    MaterialTypography,
    MaterialStyleMetrics,
    MaterialText,
    Icon,
    OutlinedCard,
    FilledCard,
    TextField,
    FilledButton,
    TonalButton,
    OutlineButton,
    TextButton,
    CheckBox,
    CheckState,
    LinearProgressIndicator,
    CircularProgressIndicator,
    Dialog,
    HorizontalDivider,
    ScrollView,
} from "@material";

export { MaterialWindowAdapter } from "@material";

export enum SelectorAction {
    toggle-row,
    open-folder,
    go-up,
    toggle-selected-only,
    select-visible,
    deselect-visible,
    toggle-sort,
}

export struct SelectorEntry {
    id: int,
    name: string,
    path: string,
    detail: string,
    size_text: string,
    checked: bool,
    partial: bool,
}

export component AppWindow inherits MaterialWindow {
    title: "MediaFire Mini";
    icon: @image-url("assets/logo.png");
    min-width: 620px;
    min-height: 580px;
    preferred-width: 700px;
    preferred-height: 620px;

    in-out property <string> url_text: "";
    in-out property <string> folder_text: "";
    in-out property <bool> make_zip: true;

    in property <string> url_error: "";
    in property <string> folder_error: "";
    in property <bool> is_running: false;
    in property <bool> is_indeterminate: false;
    in property <bool> is_cancelling: false;
    in property <bool> can_open_folder: false;
    in property <float> progress_value: 0.0;

    in property <string> status_title: "Pronto";
    in property <string> status_detail: "Incolla un link MediaFire HTTPS per scaricare la cartella o il file.";
    in property <string> progress_summary: "";
    in property <string> banner_error: "";
    in property <string> app_version;

    // Update check & single-EXE self-update state
    in property <bool> is_checking_engine: false;
    in property <bool> is_updating_app: false;
    in property <bool> app_update_available: false;
    in property <bool> engine_update_available: false;
    in property <string> engine_status_text: "Controllo aggiornamenti su GitHub...";
    in property <string> engine_update_banner: "";

    // File selector state
    in-out property <bool> selector_open: false;
    in-out property <string> filter_text: "";
    in-out property <bool> sort_name_asc: true;
    in property <[SelectorEntry]> selector_entries: [];
    in property <string> selector_path;
    in property <bool> selector_can_go_up;
    in property <bool> selector_selected_only;
    in property <bool> has_selection: false;
    in property <int> selected_count: 0;
    in property <int> total_scanned: 0;
    in property <string> selection_summary: "";
    in property <string> selector_scope_summary: "";

    callback paste_url();
    callback clear_url();
    callback url_edited(text: string);
    callback browse_folder();
    callback start_download();
    callback open_file_selector();
    callback cancel_download();
    callback open_destination();
    callback dismiss_error();

    callback check_engine_updates();
    callback apply_app_update();
    callback open_engine_release();

    callback close_selector();
    callback reset_selection();
    callback filter_changed(text: string);
    callback manage_selector(action: SelectorAction, id: int, path: string);
    callback start_selected_download();

    public function show_busy_dialog() {
        busy_dialog.show();
    }

    busy_dialog := Dialog {
        title: "Operazione in corso";
        default_action_text: "Ho capito";

        default_action_clicked => {
            self.close();
        }

        MaterialText {
            width: 340px;
            text: "Completa o annulla l'operazione prima di chiudere MediaFire Mini.";
            style: MaterialTypography.body_medium;
            color: MaterialPalette.on_surface_variant;
            wrap: word-wrap;
        }
    }

    // MAIN VIEW
    if !root.selector_open : VerticalLayout {
        padding: MaterialStyleMetrics.padding_20;
        spacing: MaterialStyleMetrics.spacing_12;

        // Header bar
        HorizontalLayout {
            spacing: MaterialStyleMetrics.spacing_12;
            vertical-stretch: 0;

            Image {
                source: @image-url("assets/logo.png");
                width: 44px;
                height: 44px;
                image-fit: contain;
            }

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 2px;

                MaterialText {
                    text: "MediaFire Mini";
                    style: MaterialTypography.title_large;
                    color: MaterialPalette.on_surface;
                }

                MaterialText {
                    text: "Scarica cartelle e file MediaFire in locale e in un unico ZIP";
                    style: MaterialTypography.body_small;
                    color: MaterialPalette.on_surface_variant;
                    wrap: word-wrap;
                }
            }

            VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;

                Rectangle {
                    background: MaterialPalette.primary_container;
                    border_radius: 14px;
                    min_height: 28px;

                    HorizontalLayout {
                        padding_left: 12px;
                        padding_right: 12px;
                        padding_top: 4px;
                        padding_bottom: 4px;

                        MaterialText {
                            text: root.app_version + " · Standalone";
                            style: MaterialTypography.label_medium;
                            color: MaterialPalette.on_primary_container;
                            vertical_alignment: center;
                        }
                    }
                }
            }
        }

        // Update banner (either 1-click single-EXE self-update or upstream mediafire_rs notice)
        if root.app_update_available || root.engine_update_available : Rectangle {
            background: root.app_update_available ? MaterialPalette.primary_container : MaterialPalette.tertiary_container;
            border_radius: MaterialStyleMetrics.border_radius_12;
            vertical-stretch: 0;

            HorizontalLayout {
                padding: MaterialStyleMetrics.padding_12;
                spacing: MaterialStyleMetrics.spacing_12;

                MaterialText {
                    horizontal-stretch: 1;
                    text: root.engine_update_banner;
                    style: MaterialTypography.body_small;
                    color: root.app_update_available ? MaterialPalette.on_primary_container : MaterialPalette.on_tertiary_container;
                    wrap: word-wrap;
                    vertical_alignment: center;
                }

                if root.app_update_available : FilledButton {
                    text: root.is_updating_app ? "Aggiorno..." : "Aggiorna ora";
                    enabled: !root.is_updating_app && !root.is_running;
                    clicked => { root.apply_app_update(); }
                }

                if !root.app_update_available && root.engine_update_available : TonalButton {
                    text: "Apri GitHub";
                    clicked => { root.open_engine_release(); }
                }
            }
        }

        // Main configuration card
        OutlinedCard {
            vertical-stretch: 0;

            VerticalLayout {
                padding: MaterialStyleMetrics.padding_16;
                spacing: MaterialStyleMetrics.spacing_12;

                // MediaFire Link Row
                HorizontalLayout {
                    spacing: MaterialStyleMetrics.spacing_12;

                    TextField {
                        horizontal-stretch: 1;
                        label: "Link MediaFire (cartella o file HTTPS)";
                        supporting_text: root.url_error != "" ? root.url_error : "Es. https://www.mediafire.com/folder/...";
                        has_error: root.url_error != "";
                        enabled: !root.is_running;
                        text <=> root.url_text;

                        edited(txt) => {
                            root.url_edited(txt);
                        }

                        accepted => {
                            if !root.is_running {
                                root.start_download();
                            }
                        }
                    }

                    VerticalLayout {
                        horizontal-stretch: 0;
                        padding_top: 8px;
                        alignment: start;

                        HorizontalLayout {
                            spacing: MaterialStyleMetrics.spacing_8;

                            if root.url_text != "" && !root.is_running : TextButton {
                                text: "Pulisci";
                                clicked => { root.clear_url(); }
                            }

                            TonalButton {
                                min-width: 108px;
                                text: "Incolla";
                                enabled: !root.is_running;
                                clicked => { root.paste_url(); }
                            }
                        }
                    }
                }

                // Destination Folder Row
                HorizontalLayout {
                    spacing: MaterialStyleMetrics.spacing_12;

                    TextField {
                        horizontal-stretch: 1;
                        label: "Cartella di destinazione";
                        supporting_text: root.folder_error != "" ? root.folder_error : "Ogni download viene salvato in una nuova sottocartella";
                        has_error: root.folder_error != "";
                        enabled: !root.is_running;
                        text <=> root.folder_text;
                    }

                    VerticalLayout {
                        horizontal-stretch: 0;
                        padding_top: 8px;
                        alignment: start;

                        OutlineButton {
                            min-width: 108px;
                            text: "Sfoglia...";
                            enabled: !root.is_running;
                            clicked => { root.browse_folder(); }
                        }
                    }
                }

                HorizontalDivider {}

                // ZIP Option Row (clickable tile)
                Rectangle {
                    border_radius: MaterialStyleMetrics.border_radius_8;
                    background: zip_touch.has_hover && !root.is_running
                        ? MaterialPalette.surface_container_low
                        : transparent;

                    HorizontalLayout {
                        padding_left: MaterialStyleMetrics.padding_4;
                        padding_right: MaterialStyleMetrics.padding_8;
                        padding_top: MaterialStyleMetrics.padding_4;
                        padding_bottom: MaterialStyleMetrics.padding_4;
                        spacing: MaterialStyleMetrics.spacing_8;

                        Rectangle {
                            horizontal-stretch: 0;
                            width: 48px;
                            height: 48px;

                            CheckBox {
                                enabled: !root.is_running;
                                check_state: root.make_zip ? CheckState.checked : CheckState.unchecked;
                            }
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 2px;

                            MaterialText {
                                text: "Crea anche un archivio ZIP unico";
                                style: MaterialTypography.body_medium;
                                color: MaterialPalette.on_surface;
                            }

                            MaterialText {
                                text: "Conserva i file originali nella cartella scaricata";
                                style: MaterialTypography.body_small;
                                color: MaterialPalette.on_surface_variant;
                            }
                        }
                    }

                    zip_touch := TouchArea {
                        enabled: !root.is_running;
                        clicked => {
                            root.make_zip = !root.make_zip;
                        }
                    }
                }

                // Active file selection summary (if scanned for current URL)
                if root.has_selection : Rectangle {
                    background: MaterialPalette.secondary_container;
                    border_radius: MaterialStyleMetrics.border_radius_8;

                    HorizontalLayout {
                        padding_left: MaterialStyleMetrics.padding_12;
                        padding_right: MaterialStyleMetrics.padding_8;
                        padding_top: MaterialStyleMetrics.padding_6;
                        padding_bottom: MaterialStyleMetrics.padding_6;
                        spacing: MaterialStyleMetrics.spacing_8;

                        MaterialText {
                            horizontal-stretch: 1;
                            text: "Selezione: " + root.selection_summary;
                            style: MaterialTypography.label_large;
                            color: MaterialPalette.on_secondary_container;
                            vertical_alignment: center;
                            overflow: elide;
                        }

                        TextButton {
                            text: "Modifica";
                            enabled: !root.is_running;
                            clicked => { root.open_file_selector(); }
                        }

                        TextButton {
                            text: "Ripristina tutti";
                            accessible-description: "Il prossimo download includerà tutti i file del link.";
                            enabled: !root.is_running;
                            clicked => { root.reset_selection(); }
                        }
                    }
                }
            }
        }

        // Action Buttons Row
        HorizontalLayout {
            spacing: MaterialStyleMetrics.spacing_8;
            vertical-stretch: 0;

            FilledButton {
                horizontal-stretch: 1;
                text: root.is_running
                    ? "In corso..."
                    : (root.has_selection
                        ? "Scarica (" + root.selected_count + "/" + root.total_scanned + ")"
                        : "Scarica");
                enabled: !root.is_running && !root.is_updating_app && (!root.has_selection || root.selected_count > 0);
                clicked => { root.start_download(); }
            }

            TonalButton {
                text: "Scegli file...";
                enabled: !root.is_running && !root.is_updating_app;
                clicked => { root.open_file_selector(); }
            }

            OutlineButton {
                text: root.is_cancelling ? "Annullo..." : "Annulla";
                enabled: root.is_running && !root.is_cancelling;
                clicked => { root.cancel_download(); }
            }

            TonalButton {
                text: "Apri destinazione";
                enabled: root.can_open_folder;
                clicked => { root.open_destination(); }
            }
        }

        // Error Banner (shown when a runtime/validation error occurs)
        if root.banner_error != "" : Rectangle {
            background: MaterialPalette.error_container;
            border_radius: MaterialStyleMetrics.border_radius_12;
            vertical-stretch: 0;

            HorizontalLayout {
                padding: MaterialStyleMetrics.padding_12;
                spacing: MaterialStyleMetrics.spacing_12;

                MaterialText {
                    horizontal-stretch: 1;
                    text: root.banner_error;
                    style: MaterialTypography.body_small;
                    color: MaterialPalette.on_error_container;
                    wrap: word-wrap;
                    vertical_alignment: center;
                }

                TextButton {
                    text: "Chiudi";
                    clicked => { root.dismiss_error(); }
                }
            }
        }

        // Progress & Status Card
        FilledCard {
            vertical-stretch: 1;

            VerticalLayout {
                padding: MaterialStyleMetrics.padding_16;
                spacing: MaterialStyleMetrics.spacing_12;
                alignment: center;

                HorizontalLayout {
                    spacing: MaterialStyleMetrics.spacing_8;

                    if root.is_running && root.is_indeterminate : CircularProgressIndicator {
                        width: 24px;
                        height: 24px;
                        indeterminate: true;
                    }

                    MaterialText {
                        horizontal-stretch: 1;
                        text: root.status_title;
                        style: MaterialTypography.title_small;
                        color: MaterialPalette.on_surface;
                        vertical_alignment: center;
                    }

                    if root.progress_summary != "" : MaterialText {
                        horizontal-stretch: 0;
                        text: root.progress_summary;
                        style: MaterialTypography.label_medium;
                        color: MaterialPalette.primary;
                        vertical_alignment: center;
                    }
                }

                if root.is_running && root.is_indeterminate : Rectangle {
                    height: MaterialStyleMetrics.size_4;
                    border_radius: MaterialStyleMetrics.border_radius_2;
                    background: MaterialPalette.primary_container;
                    clip: true;

                    Rectangle {
                        property <float> phase: mod(animation-tick(), 1.4s) / 1.4s;
                        width: parent.width * 0.35;
                        height: 100%;
                        x: -self.width + (parent.width + self.width) * self.phase;
                        border_radius: parent.border_radius;
                        background: MaterialPalette.primary;
                    }
                }

                if !(root.is_running && root.is_indeterminate) : LinearProgressIndicator {
                    progress: root.progress_value;
                }

                MaterialText {
                    text: root.status_detail;
                    style: MaterialTypography.body_small;
                    color: MaterialPalette.on_surface_variant;
                    wrap: word-wrap;
                }
            }
        }

        // Subtle Engine Check Footer
        HorizontalLayout {
            vertical-stretch: 0;
            spacing: MaterialStyleMetrics.spacing_8;

            MaterialText {
                horizontal-stretch: 1;
                text: root.engine_status_text;
                style: MaterialTypography.body_small;
                color: MaterialPalette.on_surface_variant;
                vertical_alignment: center;
                overflow: elide;
            }

            TextButton {
                text: root.is_checking_engine ? "Verifica..." : "Verifica aggiornamenti";
                enabled: !root.is_checking_engine && !root.is_running && !root.is_updating_app;
                clicked => { root.check_engine_updates(); }
            }
        }
    }

    // FILE SELECTOR VIEW
    if root.selector_open : VerticalLayout {
        padding: MaterialStyleMetrics.padding_20;
        spacing: MaterialStyleMetrics.spacing_12;

        // Top Bar
        HorizontalLayout {
            spacing: MaterialStyleMetrics.spacing_12;
            vertical-stretch: 0;

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;

                MaterialText {
                    text: "Scegli i file da scaricare";
                    style: MaterialTypography.title_large;
                    color: MaterialPalette.on_surface;
                }

                MaterialText {
                    text: "Totale selezionato: " + root.selection_summary;
                    style: MaterialTypography.body_small;
                    color: MaterialPalette.primary;
                }
            }

            TonalButton {
                text: root.selector_selected_only ? "Torna alle cartelle" : "Solo selezionati";
                enabled: root.selector_selected_only || root.selected_count > 0;
                clicked => {
                    root.manage_selector(SelectorAction.toggle-selected-only, -1, "");
                    selector_scroll.viewport_y = 0px;
                }
            }
        }

        // Filter Bar
        TextField {
            vertical-stretch: 0;
            label: "Filtra per nome o cartella...";
            text <=> root.filter_text;

            edited(txt) => {
                root.filter_changed(txt);
                selector_scroll.viewport_y = 0px;
            }
        }

        MaterialText {
            vertical-stretch: 0;
            text: root.selector_scope_summary;
            style: MaterialTypography.body_small;
            color: MaterialPalette.on_surface_variant;
        }

        // Select All / Deselect All & Sort Toolbar
        HorizontalLayout {
            spacing: MaterialStyleMetrics.spacing_8;
            vertical-stretch: 0;

            OutlineButton {
                horizontal-stretch: 0;
                text: "Seleziona risultati";
                enabled: !root.selector_selected_only && root.selector_entries.length > 0;
                clicked => { root.manage_selector(SelectorAction.select-visible, -1, ""); }
            }

            OutlineButton {
                horizontal-stretch: 0;
                text: "Deseleziona risultati";
                enabled: root.selector_entries.length > 0;
                clicked => { root.manage_selector(SelectorAction.deselect-visible, -1, ""); }
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            TonalButton {
                horizontal-stretch: 0;
                text: root.sort_name_asc ? "Ordine A–Z" : "Ordine Z–A";
                accessible-description: "Mostra prima i selezionati e cambia l'ordine alfabetico.";
                clicked => {
                    root.manage_selector(SelectorAction.toggle-sort, -1, "");
                    selector_scroll.viewport_y = 0px;
                }
            }
        }

        if !root.selector_selected_only : HorizontalLayout {
            spacing: MaterialStyleMetrics.spacing_8;
            vertical-stretch: 0;
            min-height: 40px;

            if root.selector_can_go_up : TextButton {
                text: "Cartella superiore";
                clicked => {
                    root.manage_selector(SelectorAction.go-up, -1, "");
                    selector_scroll.viewport_y = 0px;
                }
            }

            MaterialText {
                horizontal-stretch: 1;
                text: root.selector_path;
                accessible-label: root.selector_path;
                style: MaterialTypography.title_small;
                color: MaterialPalette.on_surface;
                vertical_alignment: center;
                overflow: elide;
            }
        }

        // Scrollable File List
        OutlinedCard {
            vertical-stretch: 1;

            selector_scroll := ScrollView {
                horizontal_scrollbar_policy: ScrollBarPolicy.always_off;

                VerticalLayout {
                    width: parent.visible_width;
                    padding: MaterialStyleMetrics.padding_8;
                    spacing: 2px;
                    alignment: start;

                    if root.selector_entries.length == 0 : Rectangle {
                        min-height: 120px;

                        MaterialText {
                            text: root.filter_text != "" ? "Nessun risultato per questo filtro."
                                : root.selector_selected_only ? "Nessun file selezionato."
                                : "Questa cartella non contiene file scaricabili.";
                            style: MaterialTypography.body_medium;
                            color: MaterialPalette.on_surface_variant;
                            horizontal_alignment: center;
                            vertical_alignment: center;
                        }
                    }

                    for item in root.selector_entries : Rectangle {
                        property <CheckState> displayed_state: item.checked ? CheckState.checked
                            : item.partial ? CheckState.partially-checked : CheckState.unchecked;
                        min-height: 52px;
                        border_radius: MaterialStyleMetrics.border_radius_8;
                        background: item.checked || item.partial ? MaterialPalette.surface_container_low : transparent;

                        HorizontalLayout {
                            padding_left: MaterialStyleMetrics.padding_4;
                            padding_right: MaterialStyleMetrics.padding_12;
                            padding_top: MaterialStyleMetrics.padding_4;
                            padding_bottom: MaterialStyleMetrics.padding_4;
                            spacing: MaterialStyleMetrics.spacing_8;

                            CheckBox {
                                horizontal-stretch: 0;
                                check_state: displayed_state;
                                accessible-label: item.id < 0 ? item.name + ", " + item.detail : item.name;
                                checked_state_changed(value) => {
                                    if value != displayed_state {
                                        root.manage_selector(SelectorAction.toggle-row, item.id, item.path);
                                    }
                                }
                            }

                            if item.id < 0 : Icon {
                                source: @image-url("assets/folder.svg");
                                colorize: MaterialPalette.primary;
                                width: MaterialStyleMetrics.icon_size_24;
                                height: self.width;
                                horizontal-stretch: 0;
                                accessible-role: none;
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 2px;

                                MaterialText {
                                    text: item.name;
                                    style: item.id < 0 ? MaterialTypography.title_small : MaterialTypography.body_medium;
                                    color: MaterialPalette.on_surface;
                                    overflow: elide;
                                }

                                if item.detail != "" : MaterialText {
                                    text: item.detail;
                                    style: MaterialTypography.body_small;
                                    color: MaterialPalette.on_surface_variant;
                                    overflow: elide;
                                }
                            }

                            if item.id < 0 : TextButton {
                                horizontal-stretch: 0;
                                text: "Apri";
                                accessible-label: "Apri cartella " + item.name;
                                clicked => {
                                    root.manage_selector(SelectorAction.open-folder, -1, item.path);
                                    selector_scroll.viewport_y = 0px;
                                }
                            }

                            if item.id >= 0 : MaterialText {
                                horizontal-stretch: 0;
                                text: item.size_text;
                                style: MaterialTypography.label_medium;
                                color: MaterialPalette.on_surface_variant;
                                vertical_alignment: center;
                            }
                        }

                    }
                }
            }
        }

        // Bottom Selector Action Bar
        HorizontalLayout {
            spacing: MaterialStyleMetrics.spacing_12;
            vertical-stretch: 0;

            OutlineButton {
                text: "Torna indietro";
                clicked => { root.close_selector(); }
            }

            FilledButton {
                horizontal-stretch: 1;
                text: "Scarica selezionati (" + root.selected_count + ")";
                accessible-description: "Scarica tutti i file selezionati, anche fuori dalla vista corrente.";
                enabled: root.selected_count > 0 && !root.is_running;
                clicked => { root.start_selected_download(); }
            }
        }
    }
}
